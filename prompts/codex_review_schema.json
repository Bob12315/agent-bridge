{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUIRED"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": ["string", "null"]
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "required_change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "file",
          "line",
          "problem",
          "required_change"
        ],
        "additionalProperties": false
      }
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "required": ["verdict", "text", "issues", "blocking"],
  "additionalProperties": false
}
